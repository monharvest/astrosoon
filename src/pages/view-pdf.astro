---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { pwaInfo } from 'virtual:pwa-info';

const { searchParams } = Astro.url;
const pdfUrl = searchParams.get('url');
const title = searchParams.get('title') || 'PDF Viewer';

if (!pdfUrl) {
  return Astro.redirect('/');
}
---

<html lang="mn" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - Udaxgui.com</title>
    <meta name="theme-color" content="#4b5563" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/src/styles/global.css" />
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <style>
      body, html {
        margin: 0;
        padding: 0;
        height: 100%;
        width: 100%;
        overflow: hidden;
        background-color: #525659;
      }
      .pdf-wrapper {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
      }
      .pdf-container {
        width: 100%;
        height: 100%;
        border: none;
        display: block;
      }
      #delayed-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        transform: translateY(-100%);
        transition: transform 1.5s cubic-bezier(0.4, 0, 0.2, 1);
      }
      #delayed-header.show {
        transform: translateY(0);
      }
      .loading-indicator {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 0;
        text-align: center;
        color: white;
        font-family: sans-serif;
      }
    </style>
  </head>
  <body>
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <div id="delayed-header">
      <Header />
    </div>

    <div class="loading-indicator">
      <div class="animate-spin rounded-full h-10 w-10 border-4 border-indigo-400 border-t-transparent mx-auto mb-4"></div>
      <p>PDF ачаалж байна...</p>
      <a href={pdfUrl} class="text-indigo-300 underline mt-4 block">Шууд нээх</a>
    </div>

    <div class="pdf-wrapper">
      <iframe 
        src={`${pdfUrl}#toolbar=0&navpanes=0&scrollbar=1`} 
        class="pdf-container" 
        title={title}
        allow="fullscreen"
      ></iframe>
    </div>
    
    <script is:inline>
      // Show header after 4 seconds
      setTimeout(() => {
        const header = document.getElementById('delayed-header');
        if (header) header.classList.add('show');
      }, 4000);
    </script>
    <script src="/src/pwa.ts"></script>
  </body>
</html>
