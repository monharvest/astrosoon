---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import { excerpt } from '../../utils/excerpt';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id } }));
}

const posts = await getCollection('posts');
const post = posts.find((p) => p.id === Astro.params.slug)!;
const { Content } = await render(post);

// Six posts ship without a frontmatter description; fall back to an excerpt
// so they stop inheriting the generic site-wide one.
const description = post.data.description ?? excerpt(post.body ?? '');

// og:image needs a real, absolute URL at a sane social aspect ratio.
const ogImage = post.data.heroImage
  ? (await getImage({ src: post.data.heroImage, width: 1200, height: 630, format: 'jpeg' })).src
  : undefined;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description,
  inLanguage: 'mn',
  articleSection: post.data.category,
  datePublished: post.data.pubDate,
  dateModified: post.data.updatedDate ?? post.data.pubDate,
  mainEntityOfPage: canonical,
  url: canonical,
  ...(post.data.tags?.length ? { keywords: post.data.tags.join(', ') } : {}),
  ...(ogImage ? { image: new URL(ogImage, Astro.site).href } : {}),
  author: { '@type': 'Organization', name: 'Udaxgui.com', url: Astro.site?.href },
  publisher: { '@type': 'Organization', name: 'Udaxgui.com', url: Astro.site?.href }
};

const getEncodedAssetUrl = (url: string | undefined) => {
  if (!url) return undefined;
  try {
    const isAbsolute = /^https?:\/\//i.test(url);
    const urlObj = isAbsolute
      ? new URL(url)
      : new URL(url, 'https://placeholder.local');
    const encodedPath = urlObj.pathname
      .split('/')
      .map(segment => (segment ? encodeURIComponent(decodeURIComponent(segment)) : segment))
      .join('/');

    if (isAbsolute) {
      return `${urlObj.origin}${encodedPath}${urlObj.search}${urlObj.hash}`;
    }

    return `${encodedPath}${urlObj.search}${urlObj.hash}`;
  } catch (err) {
    console.warn('Failed to encode asset url', err);
    return url;
  }
};

const pdfHref = getEncodedAssetUrl(post.data.pdfUrl);

// Get related posts (same category, excluding current post)
const relatedPosts = posts
  .filter(p => p.data.category === post.data.category && p.id !== post.id)
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate))
  .slice(0, 3);
---
<BaseLayout title={`${post.data.title} - Udaxgui.com`} description={description} metaImage={ogImage} jsonLd={jsonLd}>
  <Fragment slot="header"><Header /></Fragment>

  <article class="mx-auto max-w-3xl my-10">
    <header class="p-6">
      <h1 class="text-3xl font-semibold text-gray-900 dark:text-slate-100">{post.data.title}</h1>
      <div class="mt-2 text-sm text-gray-600 dark:text-slate-400">
        <time datetime={post.data.pubDate}>{new Date(post.data.pubDate).toLocaleDateString('mn-MN')}</time>
        {post.data.updatedDate && post.data.updatedDate !== post.data.pubDate && (
          <span> · Шинэчилсэн: <time datetime={post.data.updatedDate}>{new Date(post.data.updatedDate).toLocaleDateString('mn-MN')}</time></span>
        )}
      </div>
    </header>

    {post.data.heroImage && (
      <div class="mt-6 aspect-video relative rounded-2xl overflow-hidden">
        <Image
          src={post.data.heroImage}
          alt={post.data.title}
          width={1200}
          height={675}
          class="absolute w-full h-full object-cover"
          loading="eager"
        />
      </div>
    )}

    <div class="prose prose-slate prose-img:rounded-xl mt-6 max-w-none">
      <div class="content">
        <Content />
      </div>
    </div>

    {pdfHref && (
      <div class="mt-12 pt-8 border-t border-gray-200 dark:border-slate-700">
        <h3 class="text-xl font-semibold mb-4 text-gray-900 dark:text-slate-100">PDF хувилбар</h3>
        <div class="flex flex-wrap gap-3">
          <a
            href={pdfHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 text-white rounded-lg transition-colors shadow-sm"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            <span>PDF үзэх</span>
          </a>

          <a
            href={pdfHref}
            download
            class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 hover:bg-gray-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-gray-700 dark:text-slate-300 rounded-lg transition-colors border border-gray-200 dark:border-slate-700"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Татах</span>
          </a>
        </div>
      </div>
    )}

    <style>
      .content :global(h1) {
        @apply text-3xl font-bold mt-10 mb-6 text-gray-900 dark:text-slate-100;
      }
      .content :global(h2) {
        @apply text-2xl font-semibold mt-8 mb-4 border-b pb-2 border-gray-200 dark:border-slate-700 text-gray-900 dark:text-slate-100;
      }
      .content :global(h3) {
        @apply text-xl font-semibold mt-6 mb-3 text-gray-900 dark:text-slate-100;
      }
      .content :global(p) {
        @apply mb-4 leading-relaxed text-gray-700 dark:text-slate-300;
      }
      .content :global(ul) {
        @apply list-disc pl-6 mb-4 text-gray-700 dark:text-slate-300 space-y-2;
      }
      .content :global(ol) {
        @apply list-decimal pl-6 mb-4 text-gray-700 dark:text-slate-300 space-y-2;
      }
      .content :global(blockquote) {
        @apply border-l-4 border-gray-300 dark:border-slate-600 pl-4 italic my-6 text-gray-600 dark:text-slate-400;
      }
      .content :global(pre) {
        @apply rounded-xl p-4 overflow-x-auto mb-4 bg-gray-100 dark:bg-slate-800 text-sm text-gray-900 dark:text-slate-100;
      }
      .content :global(code) {
        @apply bg-gray-100 dark:bg-slate-800 rounded px-1.5 py-0.5 text-sm font-mono text-gray-900 dark:text-slate-100;
      }
      .content :global(a) {
        @apply text-blue-600 dark:text-blue-400 hover:underline decoration-2 underline-offset-2;
      }
      .content :global(img) {
        @apply rounded-xl my-6 w-full shadow-lg;
      }
      .content :global(table) {
        @apply w-full border-collapse mb-6;
      }
      .content :global(th),
      .content :global(td) {
        @apply border border-gray-300 dark:border-slate-700 px-4 py-2 text-gray-900 dark:text-slate-300;
      }
      .content :global(th) {
        @apply bg-gray-100 dark:bg-slate-800;
      }
      .content :global(tr) {
        @apply even:bg-gray-50 dark:even:bg-slate-800/50;
      }
      .content :global(hr) {
        @apply my-8 border-gray-200 dark:border-slate-700;
      }
      .content :global(strong) {
        @apply font-semibold text-gray-900 dark:text-slate-100;
      }
      .content :global(em) {
        @apply text-gray-800 dark:text-slate-300;
      }
    </style>
  </article>

  {relatedPosts.length > 0 && (
    <section class="mx-auto max-w-6xl my-16">
      <h2 class="text-2xl font-semibold mb-8 text-center text-gray-900 dark:text-slate-100">Холбоотой нийтлэлүүд</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {relatedPosts.map((relatedPost, index) => (
          <PostCard post={relatedPost} index={index} imageHeight="h-40" quality={60} />
        ))}
      </div>
    </section>
  )}

  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>

