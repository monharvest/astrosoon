---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { categoryClasses } from '../../utils/categoryStyles';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const posts = await getCollection('posts');
const post = posts.find((p) => p.slug === Astro.params.slug)!;
const { Content } = await post.render();
const gradient = categoryClasses[post.data.category] ?? categoryClasses.Default;

const getEncodedAssetUrl = (url: string | undefined) => {
  if (!url) return undefined;
  try {
    if (/^https?:\/\//i.test(url)) return url;
    const origin = Astro.site ?? new URL(Astro.url).origin;
    const urlObj = new URL(url, origin);
    const encodedPath = urlObj.pathname
      .split('/')
      .map(segment => (segment ? encodeURIComponent(decodeURIComponent(segment)) : segment))
      .join('/');
    return `${urlObj.origin}${encodedPath}`;
  } catch (err) {
    console.warn('Failed to encode asset url', err);
    return url;
  }
};

const pdfHref = getEncodedAssetUrl(post.data.pdfUrl);

// Get related posts (same category, excluding current post)
const relatedPosts = posts
  .filter(p => p.data.category === post.data.category && p.slug !== post.slug)
  .sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate))
  .slice(0, 3);
---
<BaseLayout title={post.data.title} description={post.data.description} metaImage={post.data.heroImage}>
  <Fragment slot="header"><Header /></Fragment>

  <article class="mx-auto max-w-3xl my-10">
    <header class="p-6">
      <h1 class="text-3xl font-semibold text-gray-900 dark:text-slate-100">{post.data.title}</h1>
      <div class="mt-2 text-sm text-gray-600 dark:text-slate-400">{new Date(post.data.pubDate).toLocaleDateString('mn-MN')}</div>
    </header>

    {post.data.heroImage && (
      <div class="mt-6 aspect-video relative rounded-2xl overflow-hidden">
        <Image
          src={post.data.heroImage}
          alt={post.data.title}
          width={1200}
          height={675}
          class="absolute w-full h-full object-cover"
          loading="eager"
        />
      </div>
    )}

    <div class="prose prose-slate prose-img:rounded-xl mt-6 max-w-none">
      <div class="content">
        <Content />
      </div>
    </div>

    {pdfHref && (
      <div class="mt-12 pt-8 border-t border-gray-200 dark:border-slate-700">
        <h3 class="text-xl font-semibold mb-4 text-gray-900 dark:text-slate-100">PDF хувилбар</h3>
        <div class="flex flex-wrap gap-3">
          <button
            id="pdf-open-btn"
            type="button"
            class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 text-white rounded-lg transition-colors shadow-sm"
            data-pdf-url={pdfHref}
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            <span>PDF үзэх</span>
          </button>

          <a
            href={pdfHref}
            download
            class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 hover:bg-gray-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-gray-700 dark:text-slate-300 rounded-lg transition-colors border border-gray-200 dark:border-slate-700"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Татах</span>
          </a>
        </div>

        <!-- PDF Overlay Modal -->
        <div 
          id="pdf-overlay" 
          class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 backdrop-blur-sm sm:p-4 md:p-8"
          role="dialog"
          aria-modal="true"
        >
          <div class="relative w-full max-w-5xl h-full sm:h-[90vh] flex flex-col bg-white dark:bg-slate-900 sm:rounded-2xl shadow-2xl overflow-hidden animate-in fade-in zoom-in duration-300">
            <!-- Modal Header -->
            <div class="flex items-center p-3 sm:p-4 border-b border-gray-200 dark:border-slate-800 bg-white dark:bg-slate-900 z-10">
              <!-- Mobile Back Button -->
              <button 
                id="pdf-back-btn"
                class="sm:hidden flex items-center gap-1 text-indigo-600 dark:text-indigo-400 font-medium mr-2"
              >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                <span>Буцах</span>
              </button>

              <div class="flex flex-col min-w-0 flex-1">
                <h3 class="text-sm sm:text-lg font-semibold text-gray-900 dark:text-white truncate pr-4">{post.data.title}</h3>
                <span class="text-[10px] uppercase tracking-wider text-gray-500 dark:text-slate-400 sm:hidden">PDF Уншигч</span>
              </div>

              <div class="flex items-center gap-1 sm:gap-2">
                <a 
                  href={pdfHref}
                  target="_blank"
                  class="p-2 hover:bg-gray-100 dark:hover:bg-slate-800 rounded-full transition-colors text-gray-500 dark:text-slate-400"
                  title="Шинэ цонхонд нээх"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
                <!-- Desktop Close Button -->
                <button 
                  id="pdf-close-btn"
                  class="hidden sm:block p-2 hover:bg-gray-100 dark:hover:bg-slate-800 rounded-full transition-colors text-gray-500 hover:text-gray-700 dark:text-slate-400 dark:hover:text-white"
                  aria-label="Close PDF"
                >
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
            </div>
            
            <!-- Modal Content -->
            <div class="flex-1 bg-gray-100 dark:bg-slate-950 relative overflow-hidden">
              <div id="pdf-loader" class="absolute inset-0 flex items-center justify-center bg-gray-100 dark:bg-slate-950 z-0">
                <div class="flex flex-col items-center gap-3">
                  <div class="animate-spin rounded-full h-10 w-10 border-4 border-indigo-500 border-t-transparent"></div>
                  <span class="text-sm text-gray-500 dark:text-slate-400">Уншиж байна...</span>
                </div>
              </div>
              <iframe
                id="pdf-iframe"
                class="w-full h-full border-none opacity-0 transition-opacity duration-300"
                title="PDF Viewer"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    )}

    <style>
      .content :global(h1) {
        @apply text-3xl font-bold mt-10 mb-6 text-gray-900 dark:text-slate-100;
      }
      .content :global(h2) {
        @apply text-2xl font-semibold mt-8 mb-4 border-b pb-2 border-gray-200 dark:border-slate-700 text-gray-900 dark:text-slate-100;
      }
      .content :global(h3) {
        @apply text-xl font-semibold mt-6 mb-3 text-gray-900 dark:text-slate-100;
      }
      .content :global(p) {
        @apply mb-4 leading-relaxed text-gray-700 dark:text-slate-300;
      }
      .content :global(ul) {
        @apply list-disc pl-6 mb-4 text-gray-700 dark:text-slate-300 space-y-2;
      }
      .content :global(ol) {
        @apply list-decimal pl-6 mb-4 text-gray-700 dark:text-slate-300 space-y-2;
      }
      .content :global(blockquote) {
        @apply border-l-4 border-gray-300 dark:border-slate-600 pl-4 italic my-6 text-gray-600 dark:text-slate-400;
      }
      .content :global(pre) {
        @apply rounded-xl p-4 overflow-x-auto mb-4 bg-gray-100 dark:bg-slate-800 text-sm text-gray-900 dark:text-slate-100;
      }
      .content :global(code) {
        @apply bg-gray-100 dark:bg-slate-800 rounded px-1.5 py-0.5 text-sm font-mono text-gray-900 dark:text-slate-100;
      }
      .content :global(a) {
        @apply text-blue-600 dark:text-blue-400 hover:underline decoration-2 underline-offset-2;
      }
      .content :global(img) {
        @apply rounded-xl my-6 w-full shadow-lg;
      }
      .content :global(table) {
        @apply w-full border-collapse mb-6;
      }
      .content :global(th),
      .content :global(td) {
        @apply border border-gray-300 dark:border-slate-700 px-4 py-2 text-gray-900 dark:text-slate-300;
      }
      .content :global(th) {
        @apply bg-gray-100 dark:bg-slate-800;
      }
      .content :global(tr) {
        @apply even:bg-gray-50 dark:even:bg-slate-800/50;
      }
      .content :global(hr) {
        @apply my-8 border-gray-200 dark:border-slate-700;
      }
      .content :global(strong) {
        @apply font-semibold text-gray-900 dark:text-slate-100;
      }
      .content :global(em) {
        @apply text-gray-800 dark:text-slate-300;
      }
    </style>
  </article>

  {relatedPosts.length > 0 && (
    <section class="mx-auto max-w-6xl my-16">
      <h2 class="text-2xl font-semibold mb-8 text-center text-gray-900 dark:text-slate-100">Холбоотой нийтлэлүүд</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {relatedPosts.map((relatedPost, index) => {
          const relatedGradient = categoryClasses[relatedPost.data.category] ?? categoryClasses.Default;
          const fallbackImage = 'https://images.unsplash.com/photo-1517817748490-0c953d85a371?q=80&w=1200&auto=format&fit=crop';
          const imageSrc = relatedPost.data.heroImage ?? fallbackImage;
          return (
            <article class="card h-full flex flex-col overflow-hidden post-card" data-category={relatedPost.data.category}>
              <a href={`/posts/${relatedPost.slug}`} class="block overflow-hidden">
                <figure class="relative h-40 w-full overflow-hidden">
                  <Image src={imageSrc} alt={relatedPost.data.title} class="h-full w-full object-cover transition duration-200 hover:scale-105" loading={index < 2 ? "eager" : "lazy"} width={400} height={160} />
                </figure>
              </a>

              <div class={`bg-gradient-to-r ${relatedGradient} p-4 text-white`}>
                <div class="badge text-xs">{relatedPost.data.category}</div>
                <h3 class="mt-3 text-lg font-semibold leading-snug">
                  <a href={`/posts/${relatedPost.slug}`} class="hover:underline">{relatedPost.data.title}</a>
                </h3>
              </div>

              <div class="p-4 flex-1">
                {relatedPost.data.description && <p class="text-sm text-slate-600 dark:text-slate-400 line-clamp-3">{relatedPost.data.description}</p>}
              </div>

              <div class="px-4 pb-4 mt-auto flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
                <span>{new Date(relatedPost.data.pubDate).toLocaleDateString('mn-MN')}</span>
                <a class="text-indigo-600 dark:text-indigo-400 hover:underline" href={`/posts/${relatedPost.slug}`}>Унших →</a>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  )}

  <Fragment slot="footer"><Footer /></Fragment>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const openBtn = document.getElementById('pdf-open-btn');
      const closeBtn = document.getElementById('pdf-close-btn');
      const backBtn = document.getElementById('pdf-back-btn');
      const overlay = document.getElementById('pdf-overlay');
      const iframe = document.getElementById('pdf-iframe') as HTMLIFrameElement;
      const loader = document.getElementById('pdf-loader');
      
      if (!openBtn || !overlay || !iframe) return;
      
      const pdfUrl = openBtn.getAttribute('data-pdf-url');
      let hasLoaded = false;

      const openModal = () => {
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
        document.body.style.overflow = 'hidden'; // Lock scroll
        
        // Add a state to history so browser back button works
        window.history.pushState({ pdfOpen: true }, '');

        if (!hasLoaded && pdfUrl) {
          iframe.src = pdfUrl;
          iframe.onload = () => {
            if (loader) loader.style.display = 'none';
            iframe.style.opacity = '1';
            hasLoaded = true;
          };
        }
      };

      const closeModal = () => {
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
        document.body.style.overflow = ''; // Unlock scroll
        
        // If we closed manually, and the state is still there, go back in history
        if (window.history.state?.pdfOpen) {
          window.history.back();
        }
      };

      openBtn.addEventListener('click', openModal);
      closeBtn?.addEventListener('click', closeModal);
      backBtn?.addEventListener('click', closeModal);

      // Handle browser back button
      window.addEventListener('popstate', (e) => {
        if (!overlay.classList.contains('hidden')) {
          overlay.classList.add('hidden');
          overlay.classList.remove('flex');
          document.body.style.overflow = '';
        }
      });

      // Close on escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !overlay.classList.contains('hidden')) {
          closeModal();
        }
      });

      // Close on clicking outside the modal content (desktop only)
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay && window.innerWidth >= 640) {
          closeModal();
        }
      });
    });
  </script>
</BaseLayout>

