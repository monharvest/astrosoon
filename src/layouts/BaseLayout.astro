---
const { title = 'Udaxgui.com', description = 'Итгэл ба амьдралын тухай нийтлэлүүд', metaImage } = Astro.props;
---
<html lang="mn" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    {metaImage && <meta property="og:image" content={metaImage} />}
    
  </head>
  <body class="min-h-full bg-slate-50 text-slate-900 font-sans">
    <slot name="header" />
    <slot name="hero" />
    <main class="max-w-[1200px] mx-auto px-4 sm:px-6 pb-16">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>