---
import { pwaInfo } from 'virtual:pwa-info';
import { ClientRouter } from 'astro:transitions';
import PWAInstallPrompt from '../components/PWAInstallPrompt.astro';

const {
  title = 'Udaxgui.com',
  description = 'Итгэл ба амьдралын тухай нийтлэлүүд',
  metaImage,
  robots = 'index,follow',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---
<html lang="mn" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    {metaImage && <meta property="og:image" content={metaImage} />}
    
    <!-- PWA Meta Tags -->
    <meta name="theme-color" content="#4b5563" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="apple-touch-icon" href="/pwa-192x192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Udaxgui" />
    
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <ClientRouter />

    <!-- Prevent FOUC: apply theme before first paint -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'dark') document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body class="preload min-h-full bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-slate-100 font-sans">
    <slot name="header" />
    <slot name="hero" />
    <main class="max-w-[1200px] mx-auto px-4 sm:px-6 pb-16">
      <slot />
    </main>
    <slot name="footer" />
    <PWAInstallPrompt />
    <script>
      import '../pwa.ts';
    </script>
    <script>
      // Remove preload class after page loads to enable transitions
      window.addEventListener('load', () => {
        document.body.classList.remove('preload');
      });
    </script>
  </body>
</html>