---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
const { post } = Astro.props as { post: CollectionEntry<'posts'> };
---
<section class="rounded-2xl overflow-hidden bg-gray-100 dark:bg-gray-900 mb-8 pt-12 relative">
  <div class="py-6 md:py-8 grid md:grid-cols-2 gap-6 items-stretch max-w-[1200px] mx-auto px-4 sm:px-6">
    <a href={`/posts/${post.slug}`} class="block group">
      <figure class="relative h-56 md:h-full rounded-xl overflow-hidden">
        <picture>
          <source
            srcset={`${post.data.heroImage ?? 'https://images.unsplash.com/photo-1529390079861-591de354faf5'}?q=80&w=1200&auto=format&fit=crop&fm=webp 1x, ${post.data.heroImage ?? 'https://images.unsplash.com/photo-1529390079861-591de354faf5'}?q=80&w=2400&auto=format&fit=crop&fm=webp 2x`}
            type="image/webp"
            media="(min-width: 768px)"
          />
          <source
            srcset={`${post.data.heroImage ?? 'https://images.unsplash.com/photo-1529390079861-591de354faf5'}?q=80&w=665&auto=format&fit=crop&fm=webp 1x, ${post.data.heroImage ?? 'https://images.unsplash.com/photo-1529390079861-591de354faf5'}?q=80&w=1330&auto=format&fit=crop&fm=webp 2x`}
            type="image/webp"
            media="(max-width: 767px)"
          />
          <source
            srcset={`${post.data.heroImage ?? 'https://images.unsplash.com/photo-1529390079861-591de354faf5'}?q=80&w=1200&auto=format&fit=crop 1x, ${post.data.heroImage ?? 'https://images.unsplash.com/photo-1529390079861-591de354faf5'}?q=80&w=2400&auto=format&fit=crop 2x`}
            type="image/jpeg"
            media="(min-width: 768px)"
          />
          <source
            srcset={`${post.data.heroImage ?? 'https://images.unsplash.com/photo-1529390079861-591de354faf5'}?q=80&w=665&auto=format&fit=crop 1x, ${post.data.heroImage ?? 'https://images.unsplash.com/photo-1529390079861-591de354faf5'}?q=80&w=1330&auto=format&fit=crop 2x`}
            type="image/jpeg"
            media="(max-width: 767px)"
          />
          <Image
            src={`${post.data.heroImage ?? 'https://images.unsplash.com/photo-1529390079861-591de354faf5'}?q=80&w=1200&auto=format&fit=crop`}
            alt={post.data.title}
            class="h-full w-full object-cover group-hover:opacity-95 transition"
            loading="eager"
            fetchpriority="high"
            width={1200}
            height={600}
          />
        <span class="absolute right-4 bottom-3 text-2xl font-bold dark:text-white text-slate-900">4</span>
      </figure>
    </a>

    <div class="flex flex-col justify-between">
      <div>
        <h2 class="text-2xl md:text-3xl font-semibold leading-snug">
          <a href={`/posts/${post.slug}`} class="hover:underline dark:text-white text-slate-900">{post.data.title}</a>
        </h2>
        {post.data.description && (
          <p class="mt-6 dark:text-white/85 text-slate-700 text-sm md:text-base line-clamp-4">{post.data.description}</p>
        )}
        <div class="mt-6 text-xs dark:text-white/75 text-slate-600">{new Date(post.data.pubDate).toLocaleDateString('mn-MN')}</div>
      </div>
    </div>
  </div>

  <div id="category-buttons" class="pt-6 pb-6 flex flex-wrap gap-2 max-w-[1200px] mx-auto px-4 sm:px-6">
    <button id="filter-all" class="px-3 py-1 rounded-full bg-slate-100 hover:bg-slate-200 dark:bg-white/10 dark:hover:bg-white/15 dark:text-white text-slate-700 filter-btn active" data-category="all">Бүгд</button>
    <button id="filter-advent" class="px-3 py-1 rounded-full bg-slate-100 hover:bg-slate-200 dark:bg-white/10 dark:hover:bg-white/15 dark:text-white text-slate-700 filter-btn" data-category="advent">Advent</button>
    <button id="filter-death-life" class="px-3 py-1 rounded-full bg-slate-100 hover:bg-slate-200 dark:bg-white/10 dark:hover:bg-white/15 dark:text-white text-slate-700 filter-btn" data-category="үхэл-ба-амилал">Үхэл ба амилал</button>
    <button id="filter-good-news" class="px-3 py-1 rounded-full bg-slate-100 hover:bg-slate-200 dark:bg-white/10 dark:hover:bg-white/15 dark:text-white text-slate-700 filter-btn" data-category="сайн-мэдээ">Сайн мэдээ</button>
    <button id="filter-teachings" class="px-3 py-1 rounded-full bg-slate-100 hover:bg-slate-200 dark:bg-white/10 dark:hover:bg-white/15 dark:text-white text-slate-700 filter-btn" data-category="сургаалт-зүйрлэлүүд">Сургаалт зүйрлэлүүд</button>
    <button id="filter-eternal" class="px-3 py-1 rounded-full bg-slate-100 hover:bg-slate-200 dark:bg-white/10 dark:hover:bg-white/15 dark:text-white text-slate-700 filter-btn" data-category="мөнх-үгийн-ойлголт">Мөнх үгийн ойлголт</button>
    <button id="filter-hell" class="px-3 py-1 rounded-full bg-slate-100 hover:bg-slate-200 dark:bg-white/10 dark:hover:bg-white/15 dark:text-white text-slate-700 filter-btn" data-category="тамын-тухай">Тамын тухай</button>
  </div>
</section>

<style>
  .filter-btn.active {
    @apply bg-slate-200 dark:bg-white/20;
  }
  
  .post-card.hidden {
    display: none !important;
  }

  .md\:sticky-active {
    @apply md:fixed md:top-0 md:left-0 md:right-0 md:z-[60] md:py-4;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .md\:sticky-active > * {
    max-width: 1200px;
    margin: 0 auto;
  }
</style>

<script>
  // Category filtering functionality
  window.addEventListener('load', () => {
    // Small delay to ensure all components are rendered
    setTimeout(() => {
      const filterButtons = document.querySelectorAll('.filter-btn');
      const categoryContainer = document.getElementById('category-buttons');
      const hero = document.querySelector('section');

      // Add sticky styles to the container when hero is out of view, but only on desktop
      if (categoryContainer && hero) {
        const observer = new IntersectionObserver(
          ([entry]) => {
            if (window.innerWidth >= 768) { // 768px is Tailwind's 'md' breakpoint
              if (!entry.isIntersecting) {
                categoryContainer.classList.add('md:sticky-active');
                // Create a fullwidth background element
                if (!document.getElementById('sticky-bg')) {
                  const bg = document.createElement('div');
                  bg.id = 'sticky-bg';
                  bg.className = 'fixed top-0 left-0 right-0 h-[60px] bg-white/95 backdrop-blur-sm border-b border-gray-200 dark:bg-gray-900/95 shadow-sm z-40 hidden md:block';
                  document.body.appendChild(bg);
                }
              } else {
                categoryContainer.classList.remove('md:sticky-active');
                const bg = document.getElementById('sticky-bg');
                if (bg) bg.remove();
              }
            }
            
            // Add window resize listener to handle switching between mobile and desktop
            window.addEventListener('resize', () => {
              if (window.innerWidth < 768) {
                categoryContainer.classList.remove(
                  'md:fixed', 'md:top-0', 'md:left-0', 'md:right-0', 'md:z-50',
                  'md:bg-white/95', 'md:backdrop-blur-sm', 'md:border-b',
                  'md:border-gray-200', 'md:dark:bg-gray-900/95', 'md:py-4',
                  'md:shadow-sm'
                );
              }
            });
          },
          { threshold: 0 }
        );

        observer.observe(hero);
      }

      filterButtons.forEach(button => {
        button.addEventListener('click', () => {
          const category = (button as HTMLElement).dataset.category;
          
          // Update active button state
          filterButtons.forEach(btn => btn.classList.remove('active'));
          button.classList.add('active');
          
          // Filter posts - query for them each time to ensure they're loaded
          const postCards = document.querySelectorAll('.post-card');
          postCards.forEach(card => {
            const postCategory = (card as HTMLElement).dataset.category;
            if (category === 'all' || postCategory === category) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          });
        });
      });
    }, 100);
  });
</script>
  </div>
</section>