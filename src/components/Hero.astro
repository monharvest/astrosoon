---
import type { CollectionEntry } from 'astro:content';
import SmartPicture from './SmartPicture.astro';
const { post } = Astro.props as { post: CollectionEntry<'posts'> };
const heroSrc = post.data.heroImage ?? 'https://images.unsplash.com/photo-1529390079861-591de354faf5';
---
<section class="rounded-2xl overflow-hidden bg-gray-100 dark:bg-slate-800 relative">
  <div class="py-6 md:py-8 grid md:grid-cols-2 gap-6 items-stretch max-w-[1200px] mx-auto px-4 sm:px-6">
    <a href={`/posts/${post.id}/`} class="block group overflow-hidden" tabindex="-1" aria-hidden="true">
      <SmartPicture
        src={heroSrc}
        alt={post.data.title}
        widths={[640, 768, 960, 1200, 1440]}
        sizes="(min-width:1024px) 48vw, 100vw"
        aspect="4/3"
        quality={60}
        loading="eager"
        fetchpriority="high"
        class="rounded-xl overflow-hidden"
      />
    </a>

    <div class="flex flex-col justify-center min-h-[200px] md:min-h-[250px]">
      <div class="px-4 py-8">
        <h1 class="text-2xl md:text-3xl font-semibold leading-snug mb-6">
          <a href={`/posts/${post.id}/`} class="hover:underline text-slate-900 dark:text-slate-100">{post.data.title}</a>
        </h1>
        {post.data.description && (
          <p class="text-slate-700 dark:text-slate-300 text-sm md:text-base line-clamp-4 mb-6">{post.data.description}</p>
        )}
  <div class="text-xs text-slate-600 dark:text-slate-400">{new Date(post.data.pubDate).toLocaleDateString('mn-MN')}</div>
      </div>
    </div>
  </div>
</section>


