---
import type { CollectionEntry } from 'astro:content';
import SmartPicture from './SmartPicture.astro';
import { categoryClasses } from '../utils/categoryStyles';
import { slugify } from '../utils/slug';
const { post, index = 0 } = Astro.props as { post: CollectionEntry<'posts'>, index?: number };
const gradient = categoryClasses[post.data.category] ?? categoryClasses.Default;
const fallbackImage = 'https://images.unsplash.com/photo-1517817748490-0c953d85a371?q=80&w=1200&auto=format&fit=crop';
const imageSrc = post.data.heroImage ?? fallbackImage;

// Convert category to slug for data attribute
const categorySlug = slugify(post.data.category);
---
<article class="card h-full flex flex-col overflow-hidden post-card" data-category={categorySlug}>
  <a href={`/posts/${post.slug}`} class="block overflow-hidden">
    <SmartPicture
      src={imageSrc}
      alt={post.data.title}
      widths={[320, 480, 640, 768, 960]}
      sizes="(min-width:1024px) 33vw, (min-width:640px) 50vw, 100vw"
      height="h-48"
      quality={58}
      loading={index < 3 ? 'eager' : 'lazy'}
      fetchpriority={index === 0 ? 'high' : 'auto'}
      class="rounded-t-xl"
    />
  </a>

  <div class={`bg-gradient-to-r ${gradient} p-4 text-white`}>
    <div class="badge text-xs">{post.data.category}</div>
    <h3 class="mt-3 text-lg font-semibold leading-snug">
      <a href={`/posts/${post.slug}`} class="hover:underline">{post.data.title}</a>
    </h3>
  </div>

  <div class="p-4 flex-1">
    {post.data.description && <p class="text-sm text-slate-600 dark:text-slate-300 line-clamp-3">{post.data.description}</p>}
  </div>

  <div class="px-4 pb-4 mt-auto flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
    <span>{new Date(post.data.pubDate).toLocaleDateString('mn-MN')}</span>
    <a class="text-indigo-600 dark:text-indigo-400 hover:underline" href={`/posts/${post.slug}`}>Унших →</a>
  </div>
</article>