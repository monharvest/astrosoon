---
import { slugify } from '../utils/slug';
const nav = [
  { href: '/', label: 'Нүүр' },
  { href: '/articles', label: 'Нийтлэлүүд' },
  { href: '/categories/сайн-мэдээ', label: 'Сайн мэдээ' }
];

const categories = [
  { href: '/categories/advent', label: 'Advent' },
  { href: '/categories/үхэл-ба-амилал', label: 'Үхэл ба амилал' },
  { href: '/categories/сайн-мэдээ', label: 'Сайн мэдээ' },
  { href: '/categories/сургаалт-зүйрлэлүүд', label: 'Сургаалт зүйрлэлүүд' },
  { href: '/categories/мөнх-үгийн-ойлголт', label: 'Мөнх үгийн ойлголт' },
  { href: '/categories/тамын-тухай', label: 'Тамын тухай' }
];
---
<header class="bg-gradient-to-r from-gray-600 to-gray-700 text-white relative sticky top-0 z-50 md:static">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-4">
    <!-- Desktop Layout -->
    <div class="hidden md:flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 font-semibold text-white">
        <span>Udaxgui.com</span>
      </a>

      <nav class="flex items-center gap-6 text-sm">
        {nav.map((n) => (
          <a class="hover:underline underline-offset-4" href={n.href}>{n.label}</a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <div class="w-full max-w-sm">
          <form action="/search" method="get" role="search" class="relative">
            <input
              type="search"
              name="q"
              placeholder="Хайх..."
              class="w-full rounded-xl bg-white/10 placeholder-white/60 text-white border border-white/15 px-10 py-2 focus:outline-none focus:ring-2 focus:ring-white/30"
            />
            <svg class="absolute left-3 top-2.5 h-5 w-5 text-white/70" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14z"/>
            </svg>
          </form>
        </div>

        <button id="theme-toggle" class="p-2 rounded-lg bg-white/10 hover:bg-white/20 transition" aria-label="Toggle theme">
          <svg id="sun-icon" class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <circle cx="12" cy="12" r="5"/>
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
          </svg>
          <svg id="moon-icon" class="hidden h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Layout -->
    <div class="md:hidden flex items-center gap-4">
      <a href="/" class="flex items-center gap-2 font-semibold text-white">
        <span>Udaxgui.com</span>
      </a>

      <div class="ml-auto flex items-center gap-2">
        <!-- Search Button -->
        <button id="search-toggle" class="p-2 rounded-lg bg-white/10 hover:bg-white/20 transition md:hidden" aria-label="Search">
          <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14z"/>
          </svg>
        </button>

        <!-- Mobile Menu Toggle -->
        <button id="mobile-menu-toggle" class="md:hidden p-2 rounded-lg bg-white/10 hover:bg-white/20 transition" aria-label="Toggle menu">
          <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>

        <button id="theme-toggle-mobile" class="p-2 rounded-lg bg-white/10 hover:bg-white/20 transition" aria-label="Toggle theme">
          <svg id="sun-icon-mobile" class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <circle cx="12" cy="12" r="5"/>
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
          </svg>
          <svg id="moon-icon-mobile" class="hidden h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Search Bar -->
  <div id="mobile-search" class="hidden px-4 pb-4">
    <form action="/search" method="get" role="search" class="relative">
      <input
        type="search"
        name="q"
        placeholder="Хайх..."
        class="w-full rounded-xl bg-white/10 placeholder-white/60 text-white border border-white/15 px-10 py-2 focus:outline-none focus:ring-2 focus:ring-white/30"
      />
      <svg class="absolute left-3 top-2.5 h-5 w-5 text-white/70" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14z"/>
      </svg>
    </form>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-gradient-to-r from-gray-600 to-gray-700 border-t border-white/10">
    <nav class="px-4 py-4">
      <h3 class="text-white/70 text-sm font-medium mb-3">Ангилалууд</h3>
      <div class="space-y-2">
        {categories.map((category) => (
          <a 
            class="block px-3 py-2 text-white hover:bg-white/10 rounded-lg transition" 
            href={category.href}
          >
            {category.label}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  // Initialize theme toggle state
  const setThemeToggleState = () => {
    const sunIcons = document.querySelectorAll('#sun-icon, #sun-icon-mobile');
    const moonIcons = document.querySelectorAll('#moon-icon, #moon-icon-mobile');
    
    const isDark = document.documentElement.classList.contains('dark');
    
    sunIcons.forEach(icon => icon.classList.toggle('hidden', isDark));
    moonIcons.forEach(icon => icon.classList.toggle('hidden', !isDark));
  };

  // Set initial state
  setThemeToggleState();

  // Handle theme toggle click
  document.querySelectorAll('#theme-toggle, #theme-toggle-mobile').forEach(toggle => {
    toggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      document.documentElement.classList.toggle('dark', !isDark);
      localStorage.setItem('theme', isDark ? 'light' : 'dark');
      setThemeToggleState();
    });
  });

  // Handle system theme changes
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (!localStorage.getItem('theme')) {
      document.documentElement.classList.toggle('dark', e.matches);
      setThemeToggleState();
    }
  });

  // Mobile menu toggle
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileSearchToggle = document.getElementById('search-toggle');
  const mobileSearch = document.getElementById('mobile-search');

  mobileMenuToggle?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden', isOpen);
    mobileSearch?.classList.add('hidden'); // Close search when opening menu
  });

  mobileSearchToggle?.addEventListener('click', () => {
    const isOpen = !mobileSearch?.classList.contains('hidden');
    mobileSearch?.classList.toggle('hidden', isOpen);
    mobileMenu?.classList.add('hidden'); // Close menu when opening search
  });

  // Close mobile menu/search when clicking outside
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('#mobile-menu-toggle') && !target.closest('#mobile-menu') && 
        !target.closest('#search-toggle') && !target.closest('#mobile-search')) {
      mobileMenu?.classList.add('hidden');
      mobileSearch?.classList.add('hidden');
    }
  });
</script>