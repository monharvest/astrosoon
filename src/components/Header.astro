---
import { slugify } from '../utils/slug';
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/', label: 'Нүүр' },
  { href: '/articles', label: 'Нийтлэлүүд' },
  { href: '/categories/сайн-мэдээ', label: 'Сайн мэдээ' }
];

const categories = [
  { href: '/categories/advent', label: 'Advent' },
  { href: '/categories/үхэл-ба-амилал', label: 'Үхэл ба амилал' },
  { href: '/categories/сайн-мэдээ', label: 'Сайн мэдээ' },
  { href: '/categories/сургаалт-зүйрлэлүүд', label: 'Сургаалт зүйрлэлүүд' },
  { href: '/categories/мөнх-үгийн-ойлголт', label: 'Мөнх үгийн ойлголт' },
  { href: '/categories/тамын-тухай', label: 'Тамын тухай' }
];
---
<header class="bg-gradient-to-r from-gray-600 to-gray-700 dark:from-gray-800 dark:to-gray-900 text-white relative sticky top-0 z-50 md:static shadow-lg">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 py-4">
    <!-- Desktop Layout -->
    <div class="hidden md:flex items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2 font-semibold text-white whitespace-nowrap shrink-0">
        <span>Udaxgui.com</span>
      </a>

      <nav class="flex items-center gap-6 text-sm">
        {nav.map((n) => (
          <a class="hover:underline underline-offset-4 whitespace-nowrap" href={n.href}>{n.label}</a>
        ))}
      </nav>

      <div class="shrink-0">
        <ThemeToggle />
      </div>
    </div>

    <!-- Mobile Layout -->
    <div class="md:hidden flex items-center gap-4">
      <a href="/" class="flex items-center gap-2 font-semibold text-white whitespace-nowrap">
        <span>Udaxgui.com</span>
      </a>

      <div class="ml-auto flex items-center gap-2 shrink-0">
        <!-- Theme Toggle -->
        <ThemeToggle />

        <!-- Mobile Menu Toggle -->
        <button id="mobile-menu-toggle" class="md:hidden p-2 rounded-lg bg-white/10 hover:bg-white/20 transition" aria-label="Toggle menu">
          <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden bg-gradient-to-r from-gray-600 to-gray-700 border-t border-white/10 -mx-4 sm:-mx-6 px-4 sm:px-6 mt-4">
      <nav class="py-4">
        <h3 class="text-white/70 text-sm font-medium mb-3">Ангилалууд</h3>
        <div class="space-y-2">
          {categories.map((category) => (
            <a 
              class="block px-3 py-2 text-white hover:bg-white/10 rounded-lg transition" 
              href={category.href}
            >
              {category.label}
            </a>
          ))}
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Close mobile menu when clicking outside
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('#mobile-menu-toggle') && !target.closest('#mobile-menu')) {
      mobileMenu?.classList.add('hidden');
    }
  });
</script>