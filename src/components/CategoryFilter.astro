---
import { getCategories } from '../utils/categories';

const { allShowsEverything = false } = Astro.props as { allShowsEverything?: boolean };
const categories = await getCategories();

const buttonClass =
  'px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 filter-btn';
---

<div
  id="category-buttons"
  class="pt-6 pb-6 flex flex-wrap gap-2 max-w-[1200px] mx-auto pr-4 sm:pr-6"
  data-all-mode={allShowsEverything ? 'all' : 'one-per-category'}
>
  <button class={`${buttonClass} active`} data-category="all" aria-pressed="true">Бүгд</button>
  {categories.map((category) => (
    <button class={buttonClass} data-category={category.slug} aria-pressed="false">{category.label}</button>
  ))}
</div>

<style>
  .filter-btn.active {
    @apply bg-slate-200 dark:bg-slate-700;
  }

  .post-card.hidden {
    display: none !important;
  }
</style>

<script>
  // Events only — the initial visible state is rendered server-side by PostGrid.
  function initCategoryFilter() {
    const container = document.getElementById('category-buttons');
    const filterButtons = document.querySelectorAll('.filter-btn');
    const postCards = document.querySelectorAll('.post-card');

    if (!container || filterButtons.length === 0 || postCards.length === 0) return;

    // On a page that lists everything, "Бүгд" means every post. On the home
    // page it means one teaser per category, matching what PostGrid rendered.
    const allShowsEverything = container.dataset.allMode === 'all';

    const setVisible = (card: Element, visible: boolean) =>
      card.classList.toggle('hidden', !visible);

    filterButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        const category = (button as HTMLElement).dataset.category;

        filterButtons.forEach(btn => {
          btn.classList.remove('active');
          btn.setAttribute('aria-pressed', 'false');
        });
        button.classList.add('active');
        button.setAttribute('aria-pressed', 'true');

        if (category === 'all') {
          const seen = new Set<string>();
          postCards.forEach(card => {
            if (allShowsEverything) return setVisible(card, true);
            const postCategory = (card as HTMLElement).dataset.category ?? '';
            setVisible(card, !seen.has(postCategory));
            seen.add(postCategory);
          });
        } else {
          postCards.forEach(card => {
            setVisible(card, (card as HTMLElement).dataset.category === category);
          });
        }
      });
    });
  }

  initCategoryFilter();
  document.addEventListener('DOMContentLoaded', initCategoryFilter);
  document.addEventListener('astro:page-load', initCategoryFilter);
</script>
