---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string | ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  aspect?: string;
  height?: string;
  quality?: number;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const {
  src,
  alt,
  widths = [320, 480, 640, 768, 960, 1200],
  sizes = '(min-width:1024px) 33vw, (min-width:640px) 50vw, 100vw',
  aspect = '3/2',
  height,
  quality = 60,
  loading = 'lazy',
  fetchpriority = 'auto',
  class: klass = '',
} = Astro.props as Props;

const isImageMeta = typeof src === 'object';
const isUnsplash = typeof src === 'string' && src.includes('images.unsplash.com');

function buildSrcset(format: 'avif' | 'webp') {
  if (!isUnsplash) return undefined;
  const strSrc = src as string;
  return widths
    .map((w) => {
      const u = new URL(strSrc);
      u.searchParams.set('w', String(w));
      u.searchParams.set('fit', 'crop');
      u.searchParams.set('q', String(quality));
      u.searchParams.set('auto', 'format');
      u.searchParams.set('fm', format);
      return `${u.toString()} ${w}w`;
    })
    .join(', ');
}

const avifSet = buildSrcset('avif');
const webpSet = buildSrcset('webp');

const unsplashFallback = (() => {
  if (!isUnsplash) return src as string;
  const u = new URL(src as string);
  u.searchParams.set('w', String(Math.max(...widths)));
  u.searchParams.set('fit', 'crop');
  u.searchParams.set('q', String(quality));
  u.searchParams.set('auto', 'format');
  return u.toString();
})();

const [aspectW, aspectH] = aspect.split('/').map(Number);
const aspectRatio = aspectW / aspectH;
const maxWidth = widths[widths.length - 1];
const computedHeight = Math.round(maxWidth / aspectRatio);

// A local image carries its own width/height, which reserves layout space
// without help — so let it keep its natural shape instead of cropping it to
// an arbitrary ratio. The `height` prop still opts into a fixed, cropped box
// (the card grid wants uniform tiles), and remote images keep the ratio box
// because their dimensions are not known at build time.
const cropToBox = Boolean(height) || !isImageMeta;
const imgClass = cropToBox ? 'h-full w-full object-cover' : 'w-full h-auto';
---
<figure
  class={`relative overflow-hidden ${klass} ${height ?? ''}`}
  style={cropToBox && !height ? `aspect-ratio:${aspectW}/${aspectH}` : undefined}
>
  {isImageMeta ? (
    <Picture
      src={src as ImageMetadata}
      alt={alt}
      widths={widths}
      sizes={sizes}
      formats={['webp']}
      fallbackFormat="webp"
      quality={quality}
      class={imgClass}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority}
    />
  ) : isUnsplash ? (
    <picture class="block w-full h-full">
      {avifSet && <source type="image/avif" srcset={avifSet} sizes={sizes} />}
      {webpSet && <source type="image/webp" srcset={webpSet} sizes={sizes} />}
      <img
        src={unsplashFallback}
        alt={alt}
        class={imgClass}
        loading={loading}
        decoding="async"
        fetchpriority={fetchpriority}
        width={maxWidth}
        height={computedHeight}
      />
    </picture>
  ) : (
    <img
      src={src as string}
      alt={alt}
      class={imgClass}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority}
      width={maxWidth}
      height={computedHeight}
    />
  )}
  <slot />
</figure>
