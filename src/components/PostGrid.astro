---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';

const {
  posts,
  showOnePerCategory = false,
  heading = 'Нийтлэлүүд'
} = Astro.props as {
  posts: CollectionEntry<'posts'>[];
  showOnePerCategory?: boolean;
  // Pass null when the page already provides its own heading, so the
  // document keeps a single h1 and no duplicate section title.
  heading?: string | null;
};

// Compute initial hidden state server-side so no JS-driven CLS on first paint
const seenCategories = new Set<string>();
const postsWithVisibility = posts.map((p) => {
  if (!showOnePerCategory) return { post: p, hidden: false };
  const cat = p.data.category ?? '';
  if (seenCategories.has(cat)) return { post: p, hidden: true };
  seenCategories.add(cat);
  return { post: p, hidden: false };
});
---
<section>
  {heading && <h2 class="text-xl font-semibold mb-4 text-slate-900 dark:text-slate-100">{heading}</h2>}
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {postsWithVisibility.map(({ post, hidden }, index) => (
      <PostCard post={post} index={index} hidden={hidden} />
    ))}
  </div>
</section>
